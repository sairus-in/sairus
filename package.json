{
  "name": "college-bus-system",
  "version": "1.0.0",
  "description": "College Bus Management System Monorepo",
  "private": true,
  "pnpm": {
    "overrides": {
      "react": "$react",
      "react-dom": "$react-dom",
      "ioredis": "^5.4.1"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "prettier": "^3.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.8.17"
  },
  "dependencies": {
    "h3-js": "^4.4.0",
    "prom-client": "^15.1.3"
  }
}
