{
  "name": "backend",
  "version": "1.0.0",
  "description": "College Bus Management System - Backend API",
  "main": "dist/app.js",
  "types": "dist/app.d.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "start": "node dist/server.js",
    "e2e:smoke": "tsx scripts/e2e-smoke.ts",
    "backfill:admin-scope": "tsx scripts/backfill-admin-scope.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts --rulesdir eslint-rules",
    "lint:route-boundaries": "node scripts/check-route-boundaries.cjs",
    "test": "vitest"
  },
  "keywords": [
    "bus",
    "management",
    "college",
    "attendance",
    "gps"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^9.2.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/websocket": "^8.3.0",
    "@google-cloud/tasks": "^6.2.1",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.71.0",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "firebase-admin": "^12.7.0",
    "google-auth-library": "^9.15.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^13.4.0",
    "shared": "workspace:*",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie": "^1.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "packageManager": "pnpm@10.32.1",
  "prisma": {
    "schema": "src/db/prisma/schema.prisma"
  }
}
