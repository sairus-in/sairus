# ============== College Bus Management System ==============
# Backend / runtime environment template
#
# Copy to `.env` at the repo root for local development.
# Optionally copy the same file to `apps/backend/.env` when running backend
# commands from `apps/backend` directly.
#
# Public client config lives in:
# - apps/admin/.env.example
# - apps/mobile/.env.example

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bus_management?schema=public"

# Cloud Run / production example:
# DATABASE_URL="postgresql://user:pass@host/db?connection_limit=5&pool_timeout=20"

# --- Redis ---
# Local Docker Redis from infra/docker/docker-compose.yml
REDIS_URL="redis://localhost:6380"

# Optional split-redis production setup (not yet fully wired end-to-end)
# REDIS_A_URL="rediss://default:<password>@host-a:port"
# REDIS_B_URL="rediss://default:<password>@host-b:port"

# --- Authentication ---
JWT_SECRET="replace_me_with_a_local_secret_at_least_32_chars"
JWT_ISSUER="college-bus-system"
JWT_MOBILE_AUDIENCE="college-bus-mobile"
JWT_ADMIN_AUDIENCE="college-bus-admin"
ADMIN_MFA_ISSUER="College Bus Admin"
ADMIN_MFA_ENCRYPTION_KEY="replace_me_with_a_random_key_at_least_32_chars"
ADMIN_COOKIE_DOMAIN=""

# --- Server / routing ---
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"
BACKEND_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# --- Cloud Tasks / GCP ---
GOOGLE_CLOUD_PROJECT=""
CLOUD_TASKS_QUEUE="system-jobs"
CLOUD_TASKS_LOCATION="asia-south1"
CLOUD_TASKS_SA_EMAIL=""
CLOUD_TASKS_SECRET="replace_me_with_a_secret_at_least_16_chars"

# --- Firebase Admin SDK (backend only; secret) ---
# Store the full service-account JSON as a single-line JSON string.
FIREBASE_PROJECT_ID=""
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_DATABASE_URL="https://your-project-default-rtdb.firebaseio.com"

# --- MSG91 (optional backend integration) ---
MSG91_AUTH_KEY=""
MSG91_ALERT_TEMPLATE_ID=""

# Planned but not yet wired repo-wide:
# METRICS_TOKEN=""
# SENTRY_DSN=""
